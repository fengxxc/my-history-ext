    "react-dom": "^18.3.1",
    "react-free-calendar": "^0.3.3",
    "react-intl": "^12.1.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.1.0",
    "typescript": "^5.4.5",
    "wxt": "^0.21.4"
  }
}
